#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
S_0x1023d9000 .scope module, "tb_counter" "tb_counter" 2 3;
 .timescale -9 -12;
v0x1023dd110_0 .var "clk", 0 0;
v0x1023dd1b0_0 .net "cnt", 3 0, v0x1023dcf80_0;  1 drivers
v0x1023dd270_0 .var "rst_n", 0 0;
S_0x1023d9180 .scope module, "dut" "counter" 2 8, 3 1 0, S_0x1023d9000;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst_n";
    .port_info 2 /OUTPUT 4 "cnt";
v0x1023d6a70_0 .net "clk", 0 0, v0x1023dd110_0;  1 drivers
v0x1023dcf80_0 .var "cnt", 3 0;
v0x1023dd030_0 .net "rst_n", 0 0, v0x1023dd270_0;  1 drivers
E_0x1023d70c0/0 .event negedge, v0x1023dd030_0;
E_0x1023d70c0/1 .event posedge, v0x1023d6a70_0;
E_0x1023d70c0 .event/or E_0x1023d70c0/0, E_0x1023d70c0/1;
    .scope S_0x1023d9180;
T_0 ;
    %wait E_0x1023d70c0;
    %load/vec4 v0x1023dd030_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v0x1023dcf80_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x1023dcf80_0;
    %addi 1, 0, 4;
    %assign/vec4 v0x1023dcf80_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x1023d9000;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1023dd110_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1023dd270_0, 0, 1;
    %end;
    .thread T_1;
    .scope S_0x1023d9000;
T_2 ;
    %delay 5000, 0;
    %load/vec4 v0x1023dd110_0;
    %inv;
    %store/vec4 v0x1023dd110_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x1023d9000;
T_3 ;
    %vpi_call 2 13 "$dumpfile", "counter.vcd" {0 0 0};
    %vpi_call 2 14 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x1023d9000 {0 0 0};
    %delay 12000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x1023dd270_0, 0, 1;
    %delay 200000, 0;
    %vpi_call 2 17 "$finish" {0 0 0};
    %end;
    .thread T_3;
    .scope S_0x1023d9000;
T_4 ;
    %vpi_call 2 21 "$monitor", "time=%0t  cnt=%d", $time, v0x1023dd1b0_0 {0 0 0};
    %end;
    .thread T_4;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "tb_counter.v";
    "counter.v";
